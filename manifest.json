{
  "manifest_version": 3,
  "name": "Chrome Vim",
  "version": "0.1.0",
  "description": "Minimal Vim-like keyboard navigation for Chrome",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["settings.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
